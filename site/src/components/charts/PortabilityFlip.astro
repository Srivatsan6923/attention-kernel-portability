---
// Winner change rate for each GPU pair, over all configurations (grey) and over
// configurations with a separated winner (accent). Each bar shows how many
// configurations it uses. Data comes from public/data/web.json at build time.

import web from '../../../public/data/web.json';

interface Props {
	/** Minimum separated-cell count for a pair to be shown. */
	minSep?: number;
}
const { minSep = 5 } = Astro.props;

const pairs = web.pairs.filter((p) => p.n_sep >= minSep);

const regimes = ['prefill', 'decode'].filter((r) => pairs.some((p) => p.regime === r));

const panels = regimes.map((regime) => {
	const rows = pairs
		.filter((p) => p.regime === regime)
		.slice()
		.sort((a, b) => b.flip - a.flip);
	const gpus = new Set(rows.flatMap((p) => [p.a, p.b]));
	return { regime, rows, nGpus: gpus.size };
});

const id = 'portability-flip';
---

<div class="pflip" id={id}>
	<div class="pflip-legend">
		<span class="pflip-key"><i class="sw sw-all"></i>All configurations</span>
		<span class="pflip-key"><i class="sw sw-sep"></i>Configurations with a clear winner (at least {
			((web.separation.practical_threshold - 1) * 100).toFixed(0)
		}% ahead and outside the bootstrap interval)</span>
	</div>

	{
		panels.map((panel) => (
			<section class="pflip-panel">
				<h4>
					{panel.regime === 'prefill' ? 'Prefill' : 'Decode'}
					<span>
						{panel.rows.length} device pairs over {panel.nGpus} GPUs
					</span>
				</h4>
				<div class="pflip-chart" data-panel={panel.regime} />
			</section>
		))
	}

	<p class="pflip-note">
		The number at the end of each bar is how many configurations the rate uses. Pairs with fewer
		than {minSep} separated configurations are not drawn.
	</p>

	<script type="application/json" data-pflip-data set:html={JSON.stringify(panels)} />
</div>

<style>
	.pflip {
		font-family: var(--font-body);
		color: var(--text-primary);
	}

	.pflip-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 28px;
		margin-bottom: 20px;
		font-size: 14px;
		color: var(--text-secondary);
	}

	.pflip-key {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.sw {
		width: 22px;
		height: 10px;
		flex: none;
	}
	.sw-all {
		background: #9e9e9e;
	}
	.sw-sep {
		background: var(--accent);
	}

	.pflip-panel + .pflip-panel {
		margin-top: 28px;
	}

	.pflip-panel h4 {
		margin: 0 0 6px;
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.pflip-panel h4 span {
		font-weight: 400;
		color: var(--text-secondary);
	}
	.pflip-panel h4 span::before {
		content: ' · ';
	}

	.pflip-chart {
		overflow-x: auto;
	}

	.pflip-note {
		margin: 20px 0 0;
		max-width: 68ch;
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-secondary);
	}
</style>

<script>
	import * as Plot from '@observablehq/plot';

	type Row = {
		regime: string;
		a: string;
		b: string;
		n: number;
		flip: number;
		n_sep: number;
		flip_sep: number;
	};
	type Panel = { regime: string; rows: Row[]; nGpus: number };

	const GREY = '#9e9e9e';
	const label = (d: Row) => `${d.a} vs ${d.b}`;

	function mount(root: HTMLElement) {
		const panels: Panel[] = JSON.parse(
			root.querySelector<HTMLElement>('[data-pflip-data]')!.textContent!
		);
		const all = panels.flatMap((p) => p.rows);
		// Share one x range across both panels so prefill and decode line up.
		const top = Math.max(...all.map((d) => Math.max(d.flip, d.flip_sep)));

		const draw = () => {
			const css = getComputedStyle(document.documentElement);
			const accent = css.getPropertyValue('--accent').trim() || '#1769aa';
			const text = css.getPropertyValue('--text-primary').trim() || '#171717';
			const muted = css.getPropertyValue('--text-secondary').trim() || '#5f6368';

			for (const panel of panels) {
				const host = root.querySelector<HTMLElement>(`[data-panel="${panel.regime}"]`)!;
				const width = Math.max(520, host.clientWidth || 720);

				// Two bars per pair, with faceted rows so the pair label stays on one line.
				const bars = panel.rows.flatMap((d) => [
					{ pair: label(d), kind: 'all', value: d.flip, cells: d.n },
					{ pair: label(d), kind: 'sep', value: d.flip_sep, cells: d.n_sep },
				]);

				const plot = Plot.plot({
					width,
					height: panel.rows.length * 42 + 46,
					marginLeft: 140,
					marginRight: 64,
					marginTop: 8,
					marginBottom: 34,
					style: {
						background: 'transparent',
						color: muted,
						fontFamily: "'IBM Plex Mono', ui-monospace, Consolas, monospace",
						fontSize: '12px',
						fontVariantNumeric: 'tabular-nums',
					},
					x: {
						domain: [0, Math.min(100, top * 100 * 1.16)],
						label: 'Winner changes between the two GPUs (% of configurations)',
						labelAnchor: 'left',
						labelOffset: 30,
						ticks: 5,
						tickSize: 3,
						grid: false,
					},
					fy: { axis: 'left', domain: panel.rows.map(label), label: null },
					y: { axis: null, domain: ['all', 'sep'], padding: 0.22 },
					color: { domain: ['all', 'sep'], range: [GREY, accent] },
					marks: [
						Plot.barX(bars, {
							fy: 'pair',
							y: 'kind',
							x: (d) => d.value * 100,
							fill: 'kind',
							insetTop: 1,
							insetBottom: 1,
						}),
						Plot.text(bars, {
							fy: 'pair',
							y: 'kind',
							x: (d) => d.value * 100,
							text: (d) => String(d.cells),
							textAnchor: 'start',
							dx: 5,
							fill: (d) => (d.kind === 'sep' ? text : muted),
						}),
						Plot.ruleX([0], { stroke: muted, strokeWidth: 1 }),
					],
				});

				host.replaceChildren(plot);
			}
		};

		draw();

		let timer: number;
		const redraw = () => {
			clearTimeout(timer);
			timer = window.setTimeout(draw, 150);
		};
		window.addEventListener('resize', redraw);
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redraw);
	}

	// Draw once the figure is close to the viewport.
	for (const root of document.querySelectorAll<HTMLElement>('.pflip')) {
		const io = new IntersectionObserver((entries) => {
			if (entries.some((e) => e.isIntersecting)) {
				io.disconnect();
				mount(root);
			}
		});
		io.observe(root);
	}
</script>
