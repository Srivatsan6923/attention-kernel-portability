---
// Faceted decode chart: one panel per GPU, two selects (batch, metric).
// Everything is derived from public/data/web.json at runtime; no number is
// written into this file. Colours come from src/lib/backends.ts, which mirrors
// the --backend-* tokens.
//
// ponytail: one Plot per GPU instead of Plot's own facets, because the panels
// need independent y domains (A10 peaks near 483 GB/s, H100 near 2980, and a
// shared axis flattens the small device). Swap to fx-facets if the devices ever
// land in the same range.
const uid = 'decode-latency';
---

<div class="decode-chart" id={uid} data-src="data/web.json">
	<div class="chart-controls">
		<label>
			Batch
			<select data-control="batch">
				<option value="b1" selected>1</option>
				<option value="b32">32</option>
			</select>
		</label>
		<label>
			Metric
			<select data-control="metric">
				<option value="latency" selected>Time per decode step (µs)</option>
				<option value="bw">Effective KV bandwidth (GB/s)</option>
			</select>
		</label>
		<span class="chart-slice" data-slice></span>
	</div>
	<div class="chart-legend" data-legend></div>
	<div class="chart-panels" data-panels>
		<p class="chart-status" data-status>Loading measurements…</p>
	</div>
	<p class="chart-note" data-note hidden></p>
	<p class="chart-note">
		Decode rows for A10 and A100 were collected under a different commit and driver than
		H100 and L40, so the panels are not a controlled cross-GPU comparison.
	</p>
</div>

<style>
	.decode-chart {
		font-family: var(--font-body);
		color: var(--text-primary);
	}

	.chart-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 20px;
		margin-bottom: 12px;
	}

	.chart-controls label {
		font-size: 14px;
		color: var(--text-secondary);
	}

	.chart-controls select {
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--text-primary);
		background: var(--background);
		border: 1px solid var(--border);
		padding: 3px 6px;
		margin-left: 6px;
	}

	.chart-slice {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-secondary);
		margin-left: auto;
	}

	.chart-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 20px;
		font-size: 14px;
		color: var(--text-secondary);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 8px 0;
	}

	.chart-legend span {
		display: inline-flex;
		align-items: center;
		gap: 7px;
	}

	.chart-legend svg {
		flex: none;
	}

	.chart-panels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px 24px;
		margin-top: 16px;
	}

	.chart-panels h4 {
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 2px;
		color: var(--text-primary);
	}

	.chart-panels h4 small {
		font-weight: 400;
		color: var(--text-secondary);
	}

	.chart-panels svg {
		color: var(--text-secondary);
		font-variant-numeric: tabular-nums;
		overflow: visible;
	}

	.chart-status {
		font-size: 15px;
		color: var(--text-secondary);
	}

	.chart-note {
		font-size: 14px;
		line-height: 1.55;
		color: var(--text-secondary);
		margin: 12px 0 0;
		max-width: 78ch;
	}
</style>

<script>
	import * as Plot from '@observablehq/plot';
	import { colourOf, BACKEND_LABEL, IMPL_BACKEND } from '../../lib/backends';

	const root = document.getElementById('decode-latency');
	if (root) setup(root as HTMLElement);

	function setup(root: HTMLElement) {
		const panels = root.querySelector('[data-panels]') as HTMLElement;
		const legend = root.querySelector('[data-legend]') as HTMLElement;
		const note = root.querySelector('[data-note]') as HTMLElement;
		const slice = root.querySelector('[data-slice]') as HTMLElement;
		const batchSel = root.querySelector('[data-control="batch"]') as HTMLSelectElement;
		const metricSel = root.querySelector('[data-control="metric"]') as HTMLSelectElement;
		let data: any = null;

		async function load() {
			const res = await fetch(root.dataset.src!);
			if (!res.ok) throw new Error(`web.json: ${res.status}`);
			data = await res.json();
			const s = data.decode_slice;
			slice.textContent = `h_kv=${s.hkv}  d=${s.head_dim}  ${s.dtype}`;
			draw();
		}

		function seriesFor(batch: string, metric: string) {
			return data[metric === 'bw' ? `decode_bw_${batch}` : `decode_latency_${batch}`];
		}

		function draw() {
			const batch = batchSel.value;
			const metric = metricSel.value;
			const isBw = metric === 'bw';
			const byGpu = seriesFor(batch, metric);
			// Device order follows devices[]; only GPUs with decode rows appear.
			const gpus = data.devices.map((d: any) => d.gpu).filter((g: string) => g in byGpu);
			const peak: Record<string, number> = Object.fromEntries(
				data.devices.map((d: any) => [d.gpu, d.bw_gbs]),
			);
			const arch: Record<string, string> = Object.fromEntries(
				data.devices.map((d: any) => [d.gpu, `${d.arch} ${d.sm}`]),
			);

			const impls = [...new Set(gpus.flatMap((g: string) => Object.keys(byGpu[g])))] as string[];
			impls.sort();
			drawLegend(impls);

			const width = Math.max(
				260,
				Math.min(360, Math.floor(panels.clientWidth / Math.min(gpus.length, 3)) - 24),
			);

			panels.replaceChildren(
				...gpus.map((gpu: string) => {
					const cell = document.createElement('div');
					const h = document.createElement('h4');
					h.innerHTML = `${gpu} <small>${arch[gpu]}</small>`;
					cell.append(h, panel(gpu, byGpu[gpu], isBw, peak[gpu], width));
					return cell;
				}),
			);

			note.hidden = !isBw;
			note.textContent = isBw
				? 'The dashed rule in each panel is that device’s measured copy bandwidth from devices[].bw_gbs. Effective KV bandwidth is the analytic KV slice size divided by the measured step time, so a point above the rule means part of the slice was served from cache, not that the kernel exceeded the hardware.'
				: '';
		}

		function panel(gpu: string, series: any, isBw: boolean, peak: number, width: number) {
			const rows = Object.entries(series).flatMap(([impl, s]: [string, any]) =>
				s.x.map((x: number, i: number) => ({ impl, x, y: s.y[i] })),
			);
			const xs = [...new Set(rows.map((r) => r.x))].sort((a, b) => a - b);
			const ymax = Math.max(...rows.map((r) => r.y), isBw ? peak : 0);

			const line = (opts: any) => [
				Plot.line(rows, {
					x: 'x',
					y: 'y',
					z: 'impl',
					stroke: (d: any) => colourOf(d.impl),
					strokeWidth: 1.4,
					strokeDasharray: (d: any) => (d.impl === 'D6-fa-prefill-at-1' ? '4,3' : null),
					...opts,
				}),
				Plot.dot(rows, { x: 'x', y: 'y', fill: (d: any) => colourOf(d.impl), r: 2 }),
			];

			return Plot.plot({
				width,
				height: 230,
				marginLeft: 52,
				marginRight: 10,
				marginTop: 10,
				marginBottom: 34,
				style: { background: 'transparent', fontSize: '11px', fontFamily: 'var(--font-mono)' },
				x: {
					type: 'log',
					label: 'KV length N (tokens)',
					labelAnchor: 'center',
					labelOffset: 30,
					ticks: xs,
					tickFormat: (d: number) => (d >= 1024 ? `${d / 1024}k` : String(d)),
				},
				y: {
					type: isBw ? 'linear' : 'log',
					label: isBw ? 'GB/s' : 'µs / step',
					labelAnchor: 'top',
					grid: true,
					domain: isBw ? [0, ymax * 1.06] : undefined,
					tickFormat: (d: number) => (d >= 1000 ? `${d / 1000}k` : String(d)),
				},
				marks: [
					Plot.frame({ stroke: 'currentColor', strokeOpacity: 0.35 }),
					...line({}),
					...(isBw && Number.isFinite(peak)
						? [
								Plot.ruleY([peak], { stroke: 'currentColor', strokeDasharray: '3,3' }),
								Plot.text([`measured peak ${peak} GB/s`], {
									frameAnchor: 'top-right',
									y: peak,
									dy: -4,
									dx: -2,
									textAnchor: 'end',
									fill: 'currentColor',
									fontSize: 10,
								}),
							]
						: []),
				],
			});
		}

		function drawLegend(impls: string[]) {
			legend.replaceChildren(
				...impls.map((impl) => {
					const el = document.createElement('span');
					const dash = impl === 'D6-fa-prefill-at-1' ? ' stroke-dasharray="4,3"' : '';
					el.innerHTML =
						`<svg width="22" height="8" aria-hidden="true"><line x1="0" y1="4" x2="22" y2="4" ` +
						`stroke="${colourOf(impl)}" stroke-width="2"${dash}></line></svg>` +
						`<span>${impl} <span style="color:var(--text-secondary)">(${BACKEND_LABEL[IMPL_BACKEND[impl]]})</span></span>`;
					return el;
				}),
			);
		}

		batchSel.addEventListener('change', draw);
		metricSel.addEventListener('change', draw);

		// Panel width comes from the container, so redraw when it changes.
		let frame = 0;
		let last = panels.clientWidth;
		new ResizeObserver(() => {
			if (!data || panels.clientWidth === last) return;
			last = panels.clientWidth;
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(draw);
		}).observe(panels);

		const start = () =>
			load().catch((err) => {
				const status = root.querySelector('[data-status]');
				if (status) status.textContent = `Could not load web.json (${err.message}).`;
			});

		// Fetch and draw only once the figure is near the viewport. This is an
		// Astro component, so it carries its own laziness instead of client:visible.
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				io.disconnect();
				start();
			},
			{ rootMargin: '200px' },
		);
		io.observe(root);
	}
</script>
