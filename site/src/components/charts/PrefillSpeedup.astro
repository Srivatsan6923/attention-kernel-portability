---
// Prefill speedup heatmap with one panel per GPU. x is sequence length, y is
// batch and colour is speedup over SDPA-flash, centred on 1.0. A select picks
// the implementation. All values come from public/data/web.json at runtime.
interface Props {
	id?: string;
}
const { id = 'fig-prefill-speedup' } = Astro.props;
---

<figure class="figure-wide prefill-speedup" id={id} data-prefill-speedup>
	<div class="chart-head">
		<div class="chart-title">
			Prefill speedup over SDPA-flash by batch and sequence length
		</div>
		<label class="chart-control">
			<span>Implementation</span>
			<select data-impl></select>
		</label>
	</div>
	<div class="chart-body" data-plot></div>
	<figcaption data-caption></figcaption>
</figure>

<script>
	import * as Plot from '@observablehq/plot';

	// Family names, used only to order and label the select.
	const FAMILY: [RegExp, string][] = [
		[/^P1-inductor|^D1-inductor/, 'TorchInductor'],
		[/^P2[bcd]?-sdpa|^D2-sdpa/, 'SDPA'],
		[/^P3-triton/, 'Triton'],
		[/^P4h-fa3/, 'FlashAttention-3'],
		[/^P4-fa2|^D3-fa-kvcache|^D6-fa-prefill-at-1/, 'FlashAttention-2'],
		[/^D4-flashinfer/, 'FlashInfer'],
		[/./, 'PyTorch reference'],
	];
	const familyIndex = (impl: string) => FAMILY.findIndex(([re]) => re.test(impl));
	const familyOf = (impl: string) => FAMILY[familyIndex(impl)][1];

	// Clamp the colour ramp at 4x in both directions. The naive kernel is up to
	// 30x slower and would wash out every other cell. Exact ratios are in the
	// cell text and the tooltip.
	const CLAMP = 4;

	type Row = {
		gpu: string;
		B: number;
		N: number;
		impl: string;
		speedup: number;
		us: number;
		base_us: number;
	};

	const isDark = () => {
		const t = document.documentElement.dataset.theme;
		return t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
	};

	const token = (el: Element, name: string) => getComputedStyle(el).getPropertyValue(name).trim();

	const fmtN = (n: number) => (n >= 1024 ? `${n / 1024}k` : String(n));
	const fmtRatio = (v: number) => (v < 10 ? v.toFixed(2) : v.toFixed(1));
	// One decimal fits in a cell. The tooltip has the exact ratio.
	const fmtCell = (v: number) => (v < 10 ? v.toFixed(1) : String(Math.round(v)));
	// Latencies range from 31 us to 227 ms, so use significant digits.
	const fmtUs = (v: number) => v.toLocaleString('en-US', { maximumSignificantDigits: 4 });

	function render(root: HTMLElement, fig: HTMLElement, web: any, impl: string) {
		const all: Row[] = web.prefill_speedup;
		const rows = all.filter((r) => r.impl === impl);

		// Keep every GPU panel in compute-capability order, even when the chosen
		// implementation did not run there.
		const gpus: string[] = web.devices
			.filter((d: any) => all.some((r) => r.gpu === d.gpu))
			.sort(
				(a: any, b: any) =>
					Number(String(a.cc).replace(/\D/g, '')) - Number(String(b.cc).replace(/\D/g, '')) ||
					a.gpu.localeCompare(b.gpu)
			)
			.map((d: any) => d.gpu);
		const cc: Record<string, string> = Object.fromEntries(
			web.devices.map((d: any) => [d.gpu, d.cc])
		);
		const panelOf = (gpu: string) => `${gpu} ${cc[gpu]}`;

		const seqs = [...new Set(all.map((r) => r.N))].sort((a, b) => a - b);
		const batches = [...new Set(all.map((r) => r.B))].sort((a, b) => b - a); // small batch at the bottom

		const dark = isDark();
		const slower = token(fig, '--failure');
		const faster = token(fig, '--success');
		const mid = token(fig, '--surface');
		// Text colour for cell labels. Dark cells get light text.
		const deepInk = dark ? '#101214' : '#ffffff';
		const midInk = token(fig, '--text-primary');
		const inkFor = (s: number) =>
			Math.abs(Math.log(s)) / Math.log(CLAMP) > 0.45 ? deepInk : midInk;

		const ticks: number[] = [];
		for (let e = -Math.log2(CLAMP); e <= Math.log2(CLAMP); e++) ticks.push(2 ** e);

		const narrow = root.clientWidth < 760;
		// Size the plot to the facets and let the figure scroll, otherwise the
		// tick labels run together at column width.
		const perFacet = 205;
		const wide = 58 + 24 + perFacet * Math.max(gpus.length, 1);
		const width = narrow
			? Math.max(320, root.clientWidth || 900)
			: Math.max(root.clientWidth || 900, wide);
		const cell = 34;
		const facet = narrow ? { fy: (d: Row) => panelOf(d.gpu) } : { fx: (d: Row) => panelOf(d.gpu) };
		const panels = gpus.map(panelOf);

		const plot = Plot.plot({
			width,
			height: (narrow ? panels.length : 1) * batches.length * cell + (narrow ? 72 : 76),
			marginLeft: 52,
			marginBottom: 44,
			marginTop: 26,
			marginRight: narrow ? 78 : 10,
			style: {
				background: 'transparent',
				color: 'var(--text-secondary)',
				fontFamily: 'var(--font-mono)',
				fontSize: '11px',
				fontVariantNumeric: 'tabular-nums',
			},
			x: { domain: seqs, label: 'sequence length N', tickFormat: fmtN },
			y: { domain: batches, label: 'batch B' },
			fx: narrow ? undefined : { domain: panels, label: null },
			fy: narrow ? { domain: panels, label: null } : undefined,
			color: {
				type: 'diverging-log',
				pivot: 1,
				domain: [1 / CLAMP, CLAMP],
				clamp: true,
				range: [slower, mid, faster],
				legend: true,
				ticks,
				tickFormat: (v: number) => `${v < 1 ? fmtRatio(v) : String(v)}x`,
				label: `speedup over SDPA-flash (colour capped at ${CLAMP}x, hover for exact value)`,
			},
			marks: [
				Plot.frame({ stroke: 'var(--border)', strokeWidth: 0.6 }),
				Plot.cell(rows, {
					...facet,
					x: 'N',
					y: 'B',
					fill: 'speedup',
					inset: 0.5,
					title: (d: Row) =>
						`${d.impl} on ${panelOf(d.gpu)}\n` +
						`B=${d.B}, N=${d.N}\n` +
						`${fmtRatio(d.speedup)}x the SDPA-flash speed\n` +
						`${fmtUs(d.us)} us against ${fmtUs(d.base_us)} us baseline`,
					tip: true,
				}),
				Plot.text(rows, {
					...facet,
					x: 'N',
					y: 'B',
					text: (d: Row) => fmtCell(d.speedup),
					fill: (d: Row) => inkFor(d.speedup),
					fontSize: 9,
					pointerEvents: 'none',
				}),
			],
		});

		root.replaceChildren(plot);
		return rows.length;
	}

	let web: Promise<any> | null = null;
	const load = () =>
		(web ??= fetch(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}data/web.json`).then((r) =>
			r.json()
		));

	function mount(fig: HTMLElement) {
		const plotEl = fig.querySelector<HTMLElement>('[data-plot]')!;
		const select = fig.querySelector<HTMLSelectElement>('[data-impl]')!;
		const caption = fig.querySelector<HTMLElement>('[data-caption]')!;

		load().then((data: any) => {
			const all: Row[] = data.prefill_speedup;
			const impls = [...new Set(all.map((r) => r.impl))].sort(
				(a, b) => familyIndex(a) - familyIndex(b) || a.localeCompare(b)
			);
			select.replaceChildren(
				...impls.map((impl) => {
					const opt = document.createElement('option');
					opt.value = impl;
					opt.textContent = `${impl} (${familyOf(impl)})`;
					return opt;
				})
			);

			const threshold = ((data.separation.practical_threshold - 1) * 100).toFixed(0);

			const draw = () => {
				const n = render(plotEl, fig, data, select.value);
				caption.textContent =
					`SDPA-flash latency divided by ${select.value} latency at the same GPU, batch and sequence ` +
					`length. Above 1.0 means ${select.value} is faster. ${n} of ${all.length} cells have data. ` +
					`Hover a cell for both latencies. Values within about ${threshold}% of 1.0 are not a ` +
					`clear difference.`;
			};
			draw();
			select.addEventListener('change', draw);

			// Fill colours are literal values, so redraw when the theme changes.
			matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw);

			let w = plotEl.clientWidth;
			new ResizeObserver(() => {
				if (Math.abs(plotEl.clientWidth - w) > 8) {
					w = plotEl.clientWidth;
					draw();
				}
			}).observe(plotEl);
		});
	}

	// Load and draw the first time the figure scrolls into view.
	const seen = new IntersectionObserver((entries) => {
		for (const e of entries) {
			if (!e.isIntersecting) continue;
			seen.unobserve(e.target);
			mount(e.target as HTMLElement);
		}
	});
	for (const fig of document.querySelectorAll<HTMLElement>('[data-prefill-speedup]')) {
		if (fig.dataset.mounted) continue;
		fig.dataset.mounted = '1';
		seen.observe(fig);
	}
</script>

<style>
	.prefill-speedup {
		margin: 40px 0;
	}
	.chart-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid var(--border);
		padding-bottom: 8px;
	}
	.chart-title {
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 600;
		color: var(--text-primary);
	}
	.chart-control {
		display: flex;
		align-items: baseline;
		gap: 8px;
		font-size: 14px;
		color: var(--text-secondary);
		white-space: nowrap;
	}
	.chart-control select {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-primary);
		background: var(--background);
		border: 1px solid var(--border);
		padding: 3px 6px;
	}
	.chart-body {
		margin-top: 12px;
		overflow-x: auto;
	}
	figcaption {
		margin-top: 12px;
		font-size: 14px;
		line-height: 1.55;
		color: var(--text-secondary);
		max-width: 78ch;
	}
	@media (max-width: 760px) {
		.chart-head {
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
